.config/nvim/lazy-lock.json

# herdr runtime files (only config.toml is tracked)
.config/herdr/*
!.config/herdr/config.toml

# Claude Code runtime files (only settings.json and skills/yomiyasu are tracked)
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/yomiyasu/

# Python bytecode cache (created when skill scripts run)
__pycache__/
